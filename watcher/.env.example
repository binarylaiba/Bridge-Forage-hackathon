# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# IBM Bob Shell API key — required for non-interactive (watcher) use.
# Create an Inference-scoped key at https://bob.ibm.com then export it:
#   export BOBSHELL_API_KEY="your-api-key-here"
# Documentation: https://bob.ibm.com/docs/shell/getting-started/install-and-setup#api-key-authentication
BOBSHELL_API_KEY=your_bob_api_key_here
